# ── Jalebi production env ──────────────────────────────────────────────────
# Copy to .env on the server. Fill EVERY value marked REQUIRED.

JALEBI_ENV=production

# ── AI provider (REQUIRED) ──────────────────────────────────────────────────
JALEBI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-REQUIRED
JALEBI_MODEL=claude-opus-4-8
JALEBI_EFFORT=medium
# Restrict which providers a request may pick (recommended):
# JALEBI_ALLOWED_PROVIDERS=anthropic

# ── Auth — email + shared secret login (REQUIRED to close the backdoor) ──────
JALEBI_ALLOW_DEV_LOGIN=true
JALEBI_SIGNUP_SECRET=REQUIRED-long-random-shared-secret     # distribute to your 100 users
JALEBI_ALLOWED_DOMAINS=ties.org                             # or JALEBI_ALLOWED_EMAILS=a@ties.org,b@ties.org
JALEBI_ADMIN_EMAILS=founder@ties.org                        # comma-separated founders/editors
JALEBI_JWT_SECRET=REQUIRED-long-random-32+char-string
JALEBI_JWT_TTL_MIN=720
JALEBI_REQUIRE_AUTH=true                                    # require a token on /evaluate

# ── Database (REQUIRED — Postgres in prod) ──────────────────────────────────
JALEBI_DATABASE_URL=postgresql+asyncpg://jalebi:CHANGE_ME@localhost:5432/jalebi
JALEBI_AUTO_CREATE=false                                    # Alembic manages the schema

# ── Knowledge base / RAG ────────────────────────────────────────────────────
JALEBI_RAG_ENABLED=true
QDRANT_URL=http://localhost:6333                             # required if running >1 worker
# QDRANT_API_KEY=

# ── CORS — lock to your dashboard origin + published extension id ───────────
JALEBI_CORS_ORIGINS=https://jalebi.example.com,chrome-extension://YOUR_PUBLISHED_EXTENSION_ID

# ── Limits / hardening ──────────────────────────────────────────────────────
JALEBI_RATE_LIMIT=60
JALEBI_SECURITY_HEADERS=true
JALEBI_REQUEST_LOG=true
JALEBI_MAX_CHARS=60000

# ── Optional integrations ───────────────────────────────────────────────────
# JALEBI_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# JALEBI_NOTIFY_ON_READY=true
# SENTRY_DSN=
