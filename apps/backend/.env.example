# Copy to .env and adjust. Never commit real secrets.
# Everything below has a runnable default — you can start with an empty .env.

JALEBI_ENV=development

# ── AI provider ────────────────────────────────────────────────────────────
# mock | anthropic | openai | gemini | xai | ollama | openrouter | groq |
# together | deepseek | mistral
JALEBI_PROVIDER=mock
# Restrict which providers a request may select (default: any configured one)
# JALEBI_ALLOWED_PROVIDERS=anthropic,openai,ollama
JALEBI_EFFORT=medium              # low | medium | high | xhigh | max
JALEBI_PIPELINE=single            # single | multi (multi = per-dimension agents)

# Provider keys + model overrides (set the ones you use)
# ANTHROPIC_API_KEY=sk-ant-...          JALEBI_MODEL=claude-opus-4-8
# OPENAI_API_KEY=sk-...                 OPENAI_MODEL=<model-id>
# GEMINI_API_KEY=...                    GEMINI_MODEL=<model-id>
# XAI_API_KEY=...                       XAI_MODEL=<model-id>
# OPENROUTER_API_KEY=...                OPENROUTER_MODEL=<model-id>
# GROQ_API_KEY=...                      GROQ_MODEL=<model-id>
# TOGETHER_API_KEY=...                  TOGETHER_MODEL=<model-id>
# DEEPSEEK_API_KEY=...                  # default model: deepseek-chat
# MISTRAL_API_KEY=...                   MISTRAL_MODEL=<model-id>
# OLLAMA_BASE_URL=http://localhost:11434/v1   OLLAMA_MODEL=llama3.1   # local, no key

# ── Auth (P3) ──────────────────────────────────────────────────────────────
JALEBI_JWT_SECRET=change-me-to-a-long-random-string
JALEBI_ADMIN_EMAILS=founder@ties.org       # comma-separated; auto-promoted to admin
JALEBI_ALLOW_DEV_LOGIN=true                # disable in production
JALEBI_REQUIRE_AUTH=false                  # require a token on /evaluate
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
# Exact origin the OAuth success page may postMessage the token to.
# Empty → derived from GOOGLE_REDIRECT_URI. Never set this to "*".
# JALEBI_OAUTH_POSTMESSAGE_ORIGIN=https://jalebi.example.com

# ── Database (P3) ──────────────────────────────────────────────────────────
JALEBI_DATABASE_URL=sqlite+aiosqlite:///./jalebi.db
# JALEBI_DATABASE_URL=postgresql+asyncpg://jalebi:jalebi@localhost:5432/jalebi
JALEBI_AUTO_CREATE=true            # dev: create tables on startup. Prod: false + Alembic

# ── Knowledge base / RAG (P4) ──────────────────────────────────────────────
JALEBI_RAG_ENABLED=true
JALEBI_RAG_TOP_K=4
JALEBI_EMBEDDING=hash             # hash (no deps) | openai
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ── Inline grammar engine (real-time /api/check) ────────────────────────────
# Empty → dependency-free heuristic checker. Set to a LanguageTool server for
# thousands of professional grammar/style rules (docker-compose ships one).
# JALEBI_LANGUAGETOOL_URL=http://localhost:8010

# ── Integrations + monitoring (P6) ─────────────────────────────────────────
# JALEBI_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# JALEBI_TEAMS_WEBHOOK=https://outlook.office.com/webhook/...
JALEBI_NOTIFY_ON_READY=false
# SENTRY_DSN=

# ── HTTP ───────────────────────────────────────────────────────────────────
JALEBI_CORS_ORIGINS=*
JALEBI_MAX_CHARS=60000
# Reverse proxies whose X-Forwarded-For header is trusted (IPs or CIDR blocks).
# Empty = directly exposed, header ignored. Set this when behind Caddy/nginx/an
# LB, otherwise a client can spoof the header to bypass rate limiting.
# JALEBI_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# ── LLM request budget ──────────────────────────────────────────────────────
JALEBI_LLM_TIMEOUT=60          # seconds per provider request
JALEBI_LLM_RETRIES=2           # SDK-level retries on transient failures
JALEBI_LLM_TOTAL_TIMEOUT=180   # ceiling for a whole evaluation, incl. retries
